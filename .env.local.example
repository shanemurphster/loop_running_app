# Copy this file to .env.local and fill in values.

# Mapbox — get a free token at https://account.mapbox.com/access-tokens/
# Without this, the app still works and renders a clean SVG fallback map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Wired up in later milestones ---

# Supabase (Milestone 1.5 — swap mock data layer for real DB)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Strava (Milestone 3 — auto-import runs; feeds the discovery engine)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Anthropic (Milestone 2 — route discovery). Server-side only. Uses Haiku
# (cheapest). Called ONCE per newly-promoted route during an explicit scan —
# never per user, never on a loop. See src/lib/discovery.ts + /api/discover-routes.
# ANTHROPIC_API_KEY=

# OpenRouteService — NOT required. Routes come from real run geometry, not
# on-demand generation, so there's nothing to call here for now.
# ORS_API_KEY=
