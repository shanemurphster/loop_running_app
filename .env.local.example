# Copy this file to .env.local and fill in values. See README.md ("Getting
# started") for the full setup walkthrough.

# --- Required — the app reads/writes through Supabase for everything ---
# Create a free project at https://supabase.com, run every file in
# supabase/migrations/ (in order) via its SQL editor, then copy these from
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is server-only — never
# prefix it NEXT_PUBLIC_, never send it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional — each independently gated, see README's "Getting started" table ---

# Mapbox — get a free token at https://account.mapbox.com/access-tokens/
# Without this, maps render as a clean SVG fallback and route drawing is off.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Strava (connect-and-import a run from /add/import). Register a free app at
# https://www.strava.com/settings/api — set its "Authorization Callback
# Domain" to "localhost" for dev (and your real domain once deployed). The
# redirect URI this app uses is /api/strava/callback; both are server-only,
# never exposed to the client. Without these, "Connect Strava" just shows a
# "not configured" message — GPX upload still works.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic — route discovery naming. Server-side only. Uses Haiku
# (cheapest). Called ONCE per newly-promoted route during an explicit scan —
# never per user, never on a loop. See src/lib/discovery.ts + /api/discover-routes.
ANTHROPIC_API_KEY=

# Set to 1 to exercise the aggregated-run discovery pipeline locally with a
# simulated activity feed (src/lib/discovery.ts). Not needed for real Strava/
# GPX imports — those feed routes directly, not through this pipeline.
# LOOP_SIMULATE_RUNS=1

# OpenRouteService — NOT required. Routes come from real run geometry, not
# on-demand generation, so there's nothing to call here for now.
# ORS_API_KEY=
